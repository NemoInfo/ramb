0    :: \f x. x
1    :: succ 0
2    :: succ 1
3    :: succ 2

succ :: \n f x. f (n f x)
pred :: \n f x. n (\g h.h (g f)) (\u.x) (\u.u)
plus :: \m n f x. m f (n f x)
mult :: \m n f. m (n f)

true  :: \t f. t
false :: \t f. f
if :: \b t f. b t f
iszero :: \n. n (\x. false) true

Y :: \f. (\x. f (x x)) (\x. f (x x))
fact_body :: \fact n. if (iszero n) 1 (mult n (fact (pred n)))
fact :: Y fact_body

if (iszero 0) 0 1?
